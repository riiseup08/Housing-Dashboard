# ============================================================
# Canadian Housing Affordability Pipeline — Environment Config
# ============================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control!

# ── Environment ─────────────────────────────────────────────
# Options: development, staging, production
PIPELINE_ENV=development

# ── Network Timeouts (seconds) ──────────────────────────────
DOWNLOAD_TIMEOUT=120
API_TIMEOUT=60

# ── Data Paths (optional overrides) ─────────────────────────
# Uncomment and modify to use custom data directories
# DATA_RAW=/mnt/data/housing-pipeline/raw
# DATA_PROCESSED=/mnt/data/housing-pipeline/processed
# DB_PATH=/mnt/data/housing-pipeline/housing.duckdb

# ── Logging ─────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Uncomment to use custom log directory
# LOG_DIR=/var/log/housing-pipeline

# ── Data Validation Thresholds ──────────────────────────────
VALIDATION_MIN_ROWS=100
VALIDATION_MAX_NULL_PCT=0.30

# ── AI Agent Configuration ──────────────────────────────────
# Get your API key from https://platform.deepseek.com
# DeepSeek is cost-effective: ~$0.14 per million input tokens
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Feature Flags (future use) ──────────────────────────────
# ENABLE_PARALLEL_EXTRACTION=false
# ENABLE_DATA_QUALITY_ALERTS=false
# ENABLE_SLACK_NOTIFICATIONS=false

# ── API Keys (if needed in future) ──────────────────────────
# STATCAN_API_KEY=your_key_here
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
## GitHub Actions secret (configure in repository settings, not in this file):
## DIGEST_RECIPIENT=recipient@example.com
